# Copy to .env and fill in credentials for a role that can CREATE table (e.g. databricks_all_writer_perms).
# Optional: PGHOST, PGPORT, PGDATABASE, PGSCHEMA (defaults: ep-wandering-scene-..., 5432, batch_release_db, public)
PGUSER=
PGPASSWORD=

# Databricks workspace for LLM (NBA + email generation) and Genie (Sales data Q&A tab).
# DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
# DATABRICKS_TOKEN=dapi...
# DATABRICKS_FM_ENDPOINT=databricks-claude-sonnet-4-6

# Genie space for Sales data Q&A tab. If unset, app looks up a space named "Butterfly Analytics".
# GENIE_SPACE_ID=your-genie-space-id
