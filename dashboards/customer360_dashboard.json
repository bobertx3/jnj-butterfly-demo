{
  "datasets": [
    {
      "name": "customer360_base",
      "displayName": "Customer 360 Base",
      "queryLines": [
        "SELECT ",
        "  account_id, account_name, region, segment, tier, ",
        "  primary_product_company, primary_product_brand, ",
        "  contact_count, lifetime_orders, lifetime_net_sales, open_pipeline_amount, avg_resolution_hours_180d ",
        "FROM bx4.butterfly.gold_customer_360"
      ]
    },
    {
      "name": "product_perf",
      "displayName": "Product Company Brand Performance",
      "queryLines": [
        "SELECT ",
        "  product_company, product_brand, customer_count, order_lines, net_sales, gross_profit ",
        "FROM bx4.butterfly.gold_product_company_brand_performance"
      ]
    },
    {
      "name": "activity_trend",
      "displayName": "Activity Trend 30d",
      "queryLines": [
        "SELECT activity_date, activity_type, activity_count, successful_count ",
        "FROM bx4.butterfly.gold_activity_trend_30d"
      ]
    },
    {
      "name": "sales_monthly",
      "displayName": "Monthly Sales",
      "queryLines": [
        "SELECT DATE_TRUNC('MONTH', invoice_date) AS sales_month, SUM(net_sales) AS monthly_net_sales, SUM(gross_profit) AS monthly_gross_profit ",
        "FROM bx4.butterfly.silver_transactions ",
        "GROUP BY DATE_TRUNC('MONTH', invoice_date)"
      ]
    },
    {
      "name": "pipeline_stage",
      "displayName": "Pipeline Stage Mix",
      "queryLines": [
        "SELECT stage_name, SUM(amount) AS pipeline_amount, COUNT(*) AS opportunities ",
        "FROM bx4.butterfly.silver_opportunities ",
        "GROUP BY stage_name"
      ]
    },
    {
      "name": "sales_region_company",
      "displayName": "Sales by Region and Company",
      "queryLines": [
        "SELECT c.region, p.product_company, SUM(t.net_sales) AS net_sales ",
        "FROM bx4.butterfly.silver_transactions t ",
        "INNER JOIN bx4.butterfly.silver_account c ON c.account_id = t.account_id ",
        "INNER JOIN bx4.butterfly.silver_product p ON p.product_id = t.product_id ",
        "GROUP BY c.region, p.product_company"
      ]
    }
  ],
