{
  "datasets": [
    {
      "name": "dq_global",
      "displayName": "DQ Global Summary",
      "queryLines": [
        "SELECT ",
        "  SUM(rules_count) AS rules_count, ",
        "  SUM(failed_records) AS failed_records, ",
        "  SUM(total_records) AS total_records, ",
        "  AVG(avg_pass_rate) AS avg_pass_rate ",
        "FROM bx4.butterfly.dq_summary"
      ]
    },
    {
      "name": "dq_by_table",
      "displayName": "DQ Summary by Table",
      "queryLines": [
        "SELECT ",
        "  table_name, ",
        "  rules_count, ",
        "  failed_records, ",
        "  total_records, ",
        "  avg_pass_rate, ",
        "  measured_at ",
        "FROM bx4.butterfly.dq_summary"
      ]
    },
    {
      "name": "dq_rules",
      "displayName": "DQ Rule Results",
      "queryLines": [
        "SELECT ",
        "  table_name, ",
        "  rule_name, ",
        "  failed_records, ",
        "  total_records, ",
        "  failure_ratio, ",
        "  measured_at ",
        "FROM bx4.butterfly.dq_rule_results"
      ]
    },
    {
      "name": "dq_monitor_assets",
      "displayName": "DQ Monitor Assets",
      "queryLines": [
        "SELECT ",
        "  table_name, ",
        "  object_id, ",
        "  refresh_id, ",
        "  metric_tables, ",
        "  updated_at ",
        "FROM bx4.butterfly.dq_monitor_assets"
      ]
    }
  ],
  "pages": [
    {
      "name": "dq_overview",
      "displayName": "Data Quality Overview",
      "pageType": "PAGE_TYPE_CANVAS",
      "layout": [
        {
          "widget": {
            "name": "dq_title_widget",
            "multilineTextboxSpec": {
              "lines": [
                "## Butterfly Data Quality Dashboard"
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 6,
            "height": 1
          }
        },
        {
          "widget": {
            "name": "dq_subtitle_widget",
            "multilineTextboxSpec": {
              "lines": [
                "API-based monitor status and rule-level quality outcomes."
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 1,
            "width": 6,
            "height": 1
          }
        },
        {
          "widget": {
            "name": "dq_kpi_rules_count",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "dq_global",
                  "fields": [
                    {
                      "name": "rules_count",
                      "expression": "`rules_count`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "rules_count",
                  "displayName": "Rules"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Rules Evaluated"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 2,
            "width": 2,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "dq_kpi_failed_records",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "dq_global",
                  "fields": [
                    {
                      "name": "failed_records",
                      "expression": "`failed_records`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "failed_records",
                  "displayName": "Failed Records"
